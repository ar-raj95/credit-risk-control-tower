[sqlfluff]
dialect = duckdb
templater = dbt
max_line_length = 120
# Long lines (LT05) allowed for readable CASE logic; column order (ST06) left to the author.
exclude_rules = LT05, ST06, AM04
processes = 1

[sqlfluff:templater:dbt]
project_dir = dbt
profiles_dir = dbt

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:indentation]
tab_space_size = 4
indent_unit = space
